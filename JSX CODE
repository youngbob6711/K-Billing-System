"use client"
import { useState } from "react"

export default function Page(){
  const [tab,setTab]=useState('dashboard')
  const [clients,setClients]=useState([
    {id:1,name:"John Doe",phone:"254712345678",pack:"30 Mbps",price:2000,status:"Active",area:"Kasarani"},
    {id:2,name:"Amina Mohamed",phone:"254733122904",pack:"40 Mbps",price:3000,status:"Active",area:"Westlands"},
    {id:3,name:"Peter Mwangi",phone:"254798556321",pack:"20 Mbps",price:1500,status:"Suspended",area:"Kayole"},
    {id:4,name:"Sarah Kamau",phone:"254721990445",pack:"35 Mbps",price:2500,status:"Active",area:"Kilimani"},
  ])
  const [newC,setNewC]=useState({name:"",phone:"",pppoe:"",pack:"30 Mbps"})
  const [search,setSearch]=useState("")

  const toggleStatus=(id)=>{
    setClients(clients.map(c=> c.id===id ? {...c, status: c.status==='Active'?'Suspended':'Active'} : c))
  }
  const addClient=()=>{
    if(!newC.name) return alert("Enter name")
    const price = { "20 Mbps":1500, "30 Mbps":2000, "35 Mbps":2500, "40 Mbps":3000 }[newC.pack]
    setClients([...clients,{id:Date.now(),name:newC.name,phone:newC.phone||"2547...",pack:newC.pack,price,status:"Active",area:"New"}])
    setNewC({name:"",phone:"",pppoe:"",pack:"30 Mbps"})
    alert(`✅ ${newC.name} created! PPPoE ${newC.pppoe||newC.name.toLowerCase()} added to MikroTik profile ${newC.pack}`)
    setTab('dashboard')
  }
  const filtered = clients.filter(c=> (c.name+c.phone+c.pack).toLowerCase().includes(search.toLowerCase()))

  return (
    <div className="min-h-screen">
      <header className="bg-gradient-to-r from-[#0A2A5A] to-[#1e5bd8] text-white p-4 sticky top-0 z-50 shadow">
        <div className="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
          <h1 className="font-black text-2xl tracking-tight">K-Billing <span className="text-[#2eff8a]">ISP Manager</span></h1>
          <div className="flex gap-2 bg-black/20 p-1 rounded-full">
            {['dashboard','tech','client'].map(t=>(
              <button key={t} onClick={()=>setTab(t)} className={`px-5 py-2 rounded-full text-sm font-bold capitalize transition ${tab===t?'bg-white text-[#0A2A5A]':'text-white/80 hover:text-white'}`}>{t==='tech'?'Technician':t==='dashboard'?'Dashboard':'Client Portal'}</button>
            ))}
          </div>
          <button onClick={()=>setTab('tech')} className="bg-[#00A651] hover:bg-[#009246] px-5 py-2 rounded-xl font-bold">+ Add Client</button>
        </div>
      </header>

      {tab==='dashboard' && (
        <div className="max-w-7xl mx-auto p-4">
          <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
            <div className="bg-white rounded-2xl p-5 shadow-sm border-l-4 border-[#00A651]"><p className="text-gray-500 text-sm">Total Clients</p><p className="text-3xl font-black">{clients.length}</p></div>
            <div className="bg-white rounded-2xl p-5 shadow-sm border-l-4 border-blue-600"><p className="text-gray-500 text-sm">Active</p><p className="text-3xl font-black text-green-700">{clients.filter(c=>c.status==='Active').length}</p></div>
            <div className="bg-white rounded-2xl p-5 shadow-sm border-l-4 border-red-500"><p className="text-gray-500 text-sm">Suspended</p><p className="text-3xl font-black text-red-700">{clients.filter(c=>c.status==='Suspended').length}</p></div>
            <div className="bg-white rounded-2xl p-5 shadow-sm border-l-4 border-[#00A651]"><p className="text-gray-500 text-sm">M-Pesa Today</p><p className="text-3xl font-black">KES 24,500</p></div>
          </div>
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div className="lg:col-span-2 bg-white rounded-2xl p-5 shadow-sm">
              <div className="flex justify-between mb-4"><h3 className="font-bold text-lg">Clients - 20/30/35/40 Mbps</h3><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search name/phone" className="border rounded-full px-4 py-2 text-sm w-48"/></div>
              <table className="w-full text-sm"><thead><tr className="text-gray-400 text-xs uppercase"><th className="text-left py-2">Name</th><th className="text-left">Phone</th><th>Package</th><th>Status</th><th>Action</th></tr></thead><tbody>{filtered.map(c=>(<tr key={c.id} className="border-t"><td className="py-3 font-medium">{c.name}</td><td>{c.phone}</td><td><span className={`px-3 py-1 rounded-full text-xs font-bold text-white ${c.pack.includes('20')?'bg-sky-500':c.pack.includes('30')?'bg-blue-600':c.pack.includes('35')?'bg-amber-500':'bg-purple-600'}`}>{c.pack}</span></td><td><span className={`px-3 py-1 rounded-full text-xs ${c.status==='Active'?'bg-green-100 text-green-700':'bg-red-100 text-red-700'}`}>{c.status}</span></td><td><button onClick={()=>toggleStatus(c.id)} className={`px-3 py-1 rounded-lg font-bold text-white ${c.status==='Active'?'bg-blue-600':'bg-[#00A651]'}`}>{c.status==='Active'?'Suspend':'Activate'}</button></td></tr>))}</tbody></table>
            </div>
            <div className="space-y-4"><div className="bg-white rounded-2xl p-5 shadow-sm"><h3 className="font-bold mb-3">Google Maps - Live Pins</h3><div className="h-56 bg-gradient-to-br from-blue-100 to-green-100 rounded-xl flex items-center justify-center text-[#0A2A5A] font-bold text-center p-4">📍 Kasarani (18) • Westlands (22)<br/>Live Client Pins</div><button onClick={()=>alert('Opening Maps')} className="w-full mt-3 bg-[#0A2A5A] text-white py-3 rounded-xl font-bold">Open Full Map</button></div><div className="bg-white rounded-2xl p-5 shadow-sm border border-green-100"><h3 className="font-bold">💚 M-Pesa Connected ✅</h3><button onClick={()=>alert('📱 STK Push sent!')} className="w-full mt-3 bg-[#00A651] text-white py-3 rounded-xl font-bold">Simulate STK Push</button></div></div>
          </div>
        </div>
      )}
      {tab==='tech' && (<div className="max-w-xl mx-auto p-6"><div className="bg-white rounded-2xl p-6 shadow-sm"><h2 className="font-black text-xl mb-4">Add New Client - Technician</h2><input value={newC.name} onChange={e=>setNewC({...newC,name:e.target.value})} placeholder="John Kamau" className="w-full border rounded-xl px-4 py-3 mt-2 mb-3"/><input value={newC.phone} onChange={e=>setNewC({...newC,phone:e.target.value})} placeholder="254712345678" className="w-full border rounded-xl px-4 py-3 mb-3"/><input value={newC.pppoe} onChange={e=>setNewC({...newC,pppoe:e.target.value})} placeholder="PPPoE Username" className="w-full border rounded-xl px-4 py-3 mb-4"/><div className="grid grid-cols-4 gap-2 mb-4">{['20 Mbps','30 Mbps','35 Mbps','40 Mbps'].map(p=>(<button key={p} onClick={()=>setNewC({...newC,pack:p})} className={`p-3 rounded-xl border-2 text-sm font-bold ${newC.pack===p?'bg-[#00A651] text-white border-[#00A651]':'bg-white'}`}>{p}</button>))}</div><div className="h-40 bg-gradient-to-br from-blue-50 to-green-50 rounded-xl flex items-center justify-center">📍 Pin dropped: Kasarani, Nairobi</div><button onClick={addClient} className="w-full mt-6 bg-[#00A651] text-white py-4 rounded-xl font-black text-lg">Add Client + Create in MikroTik</button></div></div>)}
      {tab==='client' && (<div className="max-w-md mx-auto p-6"><div className="bg-white rounded-2xl shadow-sm overflow-hidden"><div className="bg-gradient-to-r from-[#0A2A5A] to-[#00A651] text-white p-6"><h2 className="font-black text-xl">John Doe - 30 Mbps Active</h2><p className="mt-4">Balance: KES 0 • Due 28 Oct 2026</p></div><div className="p-5"><button onClick={()=>alert('📱 STK Push sent!')} className="w-full bg-[#00A651] text-white py-4 rounded-xl font-black">Pay with M-Pesa STK Push</button><div className="mt-4 text-sm">✅ 15 Oct - KES 2,000 Success</div></div></div></div>)}
    </div>
  )
}
